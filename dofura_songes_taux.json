  "calcul": {
    "formule_taux": "taux_affiche = taux_base * multiplicateur_butin",
    "formule_probabilite": "P(au moins 1 drop) = 1 - (1 - p)^(combats_eligibles * nb_joueurs)",
    "formule_esperance": "songes_moyens = 1 / (1 - (1 - p)^(combats_eligibles * nb_joueurs))",
    "combats_par_palier": { "1": 3, "2": 5, "3": 5, "4": 5, "5": 4 },
    "combats_total_songe": 22,
    "notes": [
      "Un tirage indépendant par joueur et par combat éligible.",
      "Pour 'au moins une légende parmi les 26', agréger : p_any = 1 - (1 - p_unitaire)^26 par tirage.",
      "Ne jamais présenter le résultat comme une garantie : c'est une espérance statistique."
    ]
  },

